@page "/"
@using EasyAppDev.Blazor.AutoComplete.AI

<h1>Product Search (PostgreSQL + pgvector)</h1>
<p class="text-muted">Search for products using semantic similarity. Try queries like "laptop for developers", "healthy cooking", or "outdoor adventure gear".</p>

<div class="row">
    <div class="col-md-6">
        <SemanticAutoComplete TItem="Product"
                              TextField="@(p => p.Name)"
                              SearchFields="@(p => new[] { p.Name, p.Description, p.Category })"
                              Placeholder="Search products semantically..."
                              SimilarityThreshold="0.15f"
                              MinSearchLength="3"
                              @bind-Value="selectedProduct">
            <ItemTemplate>
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <strong>@context.Name</strong>
                        <div class="text-muted small">@context.Description</div>
                    </div>
                    <span class="badge bg-success">$@context.Price.ToString("N2")</span>
                </div>
            </ItemTemplate>
        </SemanticAutoComplete>
    </div>
</div>

@if (selectedProduct is not null)
{
    <div class="card mt-4" style="max-width: 400px;">
        <div class="card-body">
            <h5 class="card-title">@selectedProduct.Name</h5>
            <h6 class="card-subtitle mb-2 text-muted">@selectedProduct.Category</h6>
            <p class="card-text">@selectedProduct.Description</p>
            <p class="card-text fw-bold text-success">$@selectedProduct.Price.ToString("N2")</p>
            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSelection">Clear</button>
        </div>
    </div>
}

<div class="mt-5">
    <h4>How it works</h4>
    <ul>
        <li>Products are indexed in PostgreSQL with pgvector extension</li>
        <li>Search queries are converted to embeddings using OpenAI text-embedding-3-small</li>
        <li>pgvector performs cosine similarity search using HNSW index</li>
        <li>Results are ranked by semantic similarity, not just keyword matching</li>
    </ul>
</div>

@code {
    private Product? selectedProduct;

    private void ClearSelection()
    {
        selectedProduct = null;
    }
}
