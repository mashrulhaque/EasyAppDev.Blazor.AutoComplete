<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Package metadata -->
    <PackageId>EasyAppDev.Blazor.AutoComplete.AI.Qdrant</PackageId>
    <Description>Qdrant provider for EasyAppDev.Blazor.AutoComplete.AI semantic search. Provides open-source vector storage with HNSW indexing for production-scale autocomplete scenarios. Supports self-hosted and cloud deployments.</Description>
    <PackageTags>blazor;autocomplete;ai;qdrant;vector-search;semantic-search;open-source;hnsw</PackageTags>

    <!-- AOT/Trimming - Note: Semantic Kernel connectors are not AOT compatible -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Suppress AOT warnings from upstream Semantic Kernel connectors -->
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <!-- Package README and Icon -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyAppDev.Blazor.AutoComplete.AI\EasyAppDev.Blazor.AutoComplete.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Semantic Kernel Qdrant connector (prerelease) -->
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Qdrant" Version="*-*" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="9.*-*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" Condition="'$(TargetFramework)' == 'net9.0'" />
  </ItemGroup>

</Project>
